<UserControl x:Class="PrimalEditor.GameProject.NewProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrimalEditor.GameProject"
             mc:Ignorable="d" Width="800"
             d:DesignHeight="450" d:DesignWidth="800">
  
    <Border CornerRadius="3" Background="{StaticResource Editor.Window.GrayBrush3}" Width="700"
            HorizontalAlignment="Center" Margin="0,30">
        <StackPanel >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ListBox 
                Width="195"
                Height="250" 
                x:Name="TemplateListbox"
                ItemsSource="{Binding ProjectTemplates}"
                SelectedItem="{Binding SelectedProjectTemplate}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProjectType}" 
                                           FontSize="18" FontFamily="Bahnschrift condensed"
                                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Width="400" Height="250" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock Width="50" Text="Name"  Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox Width="600" Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <TextBlock Width="50" Text="Path" Style="{StaticResource LightTextBlockStyle}"/>
                <TextBox Width="550" Text="{Binding ProjectPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Browse" Width="50" Margin="5,0,0,0" />
            </StackPanel>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button 
                Content="Create"
                Width="96" 
                IsDefault="True"
                IsEnabled="{Binding IsValid,UpdateSourceTrigger=PropertyChanged}"
                Click="Button_Click"
                />
                <Button Content="Exit" Width="96" Margin="30,0,0,0" IsCancel="True"/>
            </StackPanel>
            <TextBlock 
                Text="{Binding ErrorMessage,UpdateSourceTrigger=PropertyChanged}" 
                Foreground="{StaticResource Editor.RedBrush}"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
